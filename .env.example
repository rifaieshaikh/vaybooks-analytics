MONGODB_URI=mongodb://127.0.0.1:27017/vay-reports
# Optional first-run admin password. Change it after the first login.
# VAY_BOOTSTRAP_PASSWORD=
# Set to 1 only when the app is served over HTTPS.
# VAY_COOKIE_SECURE=0
# Optional CORS for the Vite app when it is not proxied.
# VAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional folder for PDF zip exports (default: ./vay_reports).
# VAY_EXPORT_DIR=
# Desktop / LAN server (Electron sets these).
# VAY_HOST=0.0.0.0
# VAY_PORT=8765
# Optional login throttle (attempts / window seconds).
# VAY_LOGIN_RATE_LIMIT=10
# VAY_LOGIN_RATE_WINDOW=300
